  "$defs": {
    "tooth": {
      "type": "object",
      "description": "Un diente: mapa de parte (root, vestibular, lingual, mesial, distal, occlusal) a estado clínico.",
      "properties": {
        "root": {
          "$ref": "#/$defs/status"
        },
        "vestibular": {
          "$ref": "#/$defs/status"
        },
        "lingual": {
          "$ref": "#/$defs/status"
        },
        "mesial": {
          "$ref": "#/$defs/status"
        },
        "distal": {
          "$ref": "#/$defs/status"
        },
        "occlusal": {
          "$ref": "#/$defs/status"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "description": "Estado clínico de una parte del diente.",
      "enum": [
        "normal",
        "caries",
        "restaurado",
        "extraido",
        "aExtraer",
        "ausente",
        "coronaBuena",
        "coronaMala",
        "selladoBueno",
        "selladoMalo",
        "protesisBuena",
        "protesisMala",
        "implanteBueno",
        "implanteMalo"
      ]
    }
